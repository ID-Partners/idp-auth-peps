{
  "name": "@id-partners/authzen-pep",
  "version": "0.4.0",
  "description": "AuthZEN 1.0 Policy Enforcement Point for Node — Express/Connect middleware for REST APIs and a COAZ (AuthZEN MCP profile) guard for MCP tools/call.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run clean && npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "authzen",
    "authorization",
    "pep",
    "pdp",
    "mcp",
    "coaz",
    "pingauthorize",
    "express",
    "middleware"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ID-Partners/idp-auth-peps.git",
    "directory": "sdk/node"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
